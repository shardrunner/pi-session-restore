{
  "name": "pi-session-restore",
  "version": "0.1.0",
  "description": "Manually restore bookmarked Pi sessions in separate terminal windows with cross-process startup acknowledgement.",
  "type": "module",
  "license": "MIT",
  "author": "Michael Brunner",
  "keywords": [
    "pi-package",
    "pi",
    "sessions"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "linux"
  ],
  "files": [
    "index.ts",
    "core.ts",
    "README.md",
    "LICENSE",
    "docs/ai/release-checklist.md",
    "docs/ai/simplification-decisions.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test *.test.ts",
    "test:integration": "python3 smoke-test.py",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write '*.ts' '*.json' '*.md' 'docs/**/*.md' '.github/**/*.yml'",
    "format:check": "prettier --check '*.ts' '*.json' '*.md' 'docs/**/*.md' '.github/**/*.yml'"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
